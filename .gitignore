# Python
*.py[cod]               # Archivos compilados de Python
*$py.class               # Archivos de caché de Python
__pycache__/            # Directorios de caché de Python
__pycache__

# Entornos virtuales
env/                     # Directorios de entornos virtuales
venv/
ENV/
env.bak/
venv.bak/

# Archivos de configuración del IDE
.idea/                   # PyCharm y otros IDEs
.vscode/                 # Visual Studio Code
*.iml                    # Archivos de configuración de IntelliJ IDEA

# Archivos de configuración de editor
*.swp                    # Archivos temporales de Vim
*.swo
*.swn

# Archivos generados por el sistema operativo
.DS_Store                # macOS
Thumbs.db                # Windows

# Archivos de logs
*.log

# Archivos de base de datos
*.sqlite3

# Archivos generados por el paquete de distribución
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
sdist/
develop-eggs/
.installed.cfg
*.manifest
*.spec

# Dependencias de paquetes
Pipfile.lock             # Bloqueo de dependencias con Pipenv
*.tox/
*.nox/
*.coverage
.coverage.*
*.hypothesis/
.tox/
nosetests.xml
coverage.xml
*.hypothesis/

# Otros archivos temporales
*.bak
*.tmp
tempCodeRunnerFile.py
